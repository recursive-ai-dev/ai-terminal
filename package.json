{
  "name": "ai-terminal",
  "private": true,
  "version": "1.0.0",
  "description": "Linux-native AI terminal with an approval-first copilot and neural computing lab",
  "author": "AI Terminal",
  "main": "electron-dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:compile": "tsc -p tsconfig.electron.json && node scripts/write-electron-package.mjs",
    "electron:dev": "npm run build && npm run electron:compile && electron electron-dist/main.js",
    "electron:build": "npm run build && npm run electron:compile && electron-builder",
    "dist:linux": "npm run build && npm run electron:compile && electron-builder --linux appimage"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vite-plugin-singlefile": "2.3.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
