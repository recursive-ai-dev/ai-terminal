{
  // ── TypeScript config for Electron main process compilation ──
  // Target: Node.js CommonJS (Electron's main process runtime)
  // Input:  electron/
  // Output: electron-dist/
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "CommonJS",
    "moduleResolution": "node",
    "outDir":           "./electron-dist",
    "rootDir":          "./electron",
    "lib":              ["ES2020"],
    "types":            ["node"],

    // ── Strict mode ──
    "strict":           true,
    "noImplicitAny":    true,
    "strictNullChecks": true,

    // ── Emit ──
    "declaration":      true,
    "declarationMap":   false,
    "sourceMap":        true,
    "esModuleInterop":  true,
    "resolveJsonModule":true,

    // ── Electron has no DOM in main process ──
    "skipLibCheck":     true
  },
  "include": [
    "electron/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src"
  ]
}
